<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:BukaMusicDesktop.Controls">

    <!-- 参考 BetterGI 的深色卡片式布局，主色沿用 BukaMusic 的天空蓝 -->
    <Color x:Key="BgColor">#FF1B1C21</Color>
    <Color x:Key="BgElevatedColor">#FF212228</Color>
    <Color x:Key="SidebarColor">#FF151619</Color>
    <Color x:Key="NavHoverColor">#FF26282E</Color>
    <Color x:Key="CardColor">#FF26272E</Color>
    <Color x:Key="CardHoverColor">#FF2E3038</Color>
    <Color x:Key="StrokeColor">#FF34363F</Color>
    <Color x:Key="AccentColor">#FF4FC3F7</Color>
    <Color x:Key="AccentDimColor">#FF2C6C8A</Color>
    <Color x:Key="TextPrimaryColor">#FFEDF1F5</Color>
    <Color x:Key="TextSecondaryColor">#FF9AA6B2</Color>
    <Color x:Key="SuccessColor">#FF6ED48B</Color>
    <Color x:Key="WarnColor">#FFE7C36B</Color>
    <Color x:Key="ErrorColor">#FFE07A7A</Color>

    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}" />
    <SolidColorBrush x:Key="BgElevatedBrush" Color="{StaticResource BgElevatedColor}" />
    <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource SidebarColor}" />
    <SolidColorBrush x:Key="NavHoverBrush" Color="{StaticResource NavHoverColor}" />
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}" />
    <SolidColorBrush x:Key="CardHoverBrush" Color="{StaticResource CardHoverColor}" />
    <SolidColorBrush x:Key="StrokeBrush" Color="{StaticResource StrokeColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentDimBrush" Color="{StaticResource AccentDimColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="WarnBrush" Color="{StaticResource WarnColor}" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}" />

    <FontFamily x:Key="UiFont">Microsoft YaHei UI, Segoe UI</FontFamily>

    <!-- 卡片 -->
    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="18" />
    </Style>

    <Style x:Key="SectionCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
        <Setter Property="Padding" Value="20" />
        <Setter Property="Margin" Value="0,0,0,14" />
    </Style>

    <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <Style x:Key="HintTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="LabelTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    </Style>

    <Style x:Key="ValueTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <!-- 长文本用：超出宽度时自动左右滚动 -->
    <Style x:Key="MarqueeLabelStyle" TargetType="controls:MarqueeText">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="MarqueeValueStyle" TargetType="controls:MarqueeText">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- 主按钮 -->
    <Style x:Key="AccentButtonStyle" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="#FF10222E" />
        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="16,7" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style x:Key="GhostButtonStyle" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="Background" Value="#FF2C2F37" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
        <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
    </Style>

    <!-- 左侧导航按钮 -->
    <Style x:Key="NavButtonStyle" TargetType="ToggleButton">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="14,12" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Margin" Value="0,2,0,2" />
    </Style>

    <!-- 导航选中态：天蓝填充 + 深色文字（参考 BetterGI 的左侧栏高亮） -->
    <SolidColorBrush x:Key="ToggleButtonBackground" Color="Transparent" />
    <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver" Color="#FF26282E" />
    <SolidColorBrush x:Key="ToggleButtonBackgroundPressed" Color="#FF2E3038" />
    <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#FF6FD0FA" />
    <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#FF3FB2E8" />
    <SolidColorBrush x:Key="ToggleButtonForeground" Color="#FFB9C2CB" />
    <SolidColorBrush x:Key="ToggleButtonForegroundPointerOver" Color="#FFEDF1F5" />
    <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="#FF10222E" />
    <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="#FF10222E" />
    <SolidColorBrush x:Key="ToggleButtonBorderBrush" Color="Transparent" />
    <SolidColorBrush x:Key="ToggleButtonBorderBrushPointerOver" Color="Transparent" />
    <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="Transparent" />

    <!-- ==================================================================
         深色控件配色
         界面本身是深色设计，但 WinUI 的勾选框 / 下拉框 / 输入框 / 滑块在
         浅色系统主题下默认是半透明白色，和界面完全不搭。这里把这些控件的
         主题资源统一改成灰色系，选中态用天空蓝主色。
         ================================================================== -->

    <!--
         勾选框不再自定义任何笔刷：WinUI 深色主题的默认值本来就是"透明容器 + 浅灰
         描边的方框 + 主色勾选"，之前覆盖 CheckBoxBackground*/CheckBoxCheckBackground*
         反而把整行背景涂灰、方框没有填充。
         只把系统强调色改成应用主色，勾选态、开关、滑块就都是天空蓝了。
    -->
    <Color x:Key="SystemAccentColor">#FF4FC3F7</Color>
    <Color x:Key="SystemAccentColorLight1">#FF6FD0FA</Color>
    <Color x:Key="SystemAccentColorLight2">#FF8FDDFC</Color>
    <Color x:Key="SystemAccentColorLight3">#FFAFEAFE</Color>
    <Color x:Key="SystemAccentColorDark1">#FF3FB2E8</Color>
    <Color x:Key="SystemAccentColorDark2">#FF2E93C6</Color>
    <Color x:Key="SystemAccentColorDark3">#FF1F76A3</Color>

    <!-- 开关 -->
    <SolidColorBrush x:Key="ToggleSwitchContainerBackground" Color="Transparent" />
    <SolidColorBrush x:Key="ToggleSwitchContainerBackgroundPointerOver" Color="Transparent" />
    <SolidColorBrush x:Key="ToggleSwitchContainerBackgroundPressed" Color="Transparent" />
    <SolidColorBrush x:Key="ToggleSwitchContainerBackgroundDisabled" Color="Transparent" />
    <SolidColorBrush x:Key="ToggleSwitchFillOff" Color="#FF3A3D46" />
    <SolidColorBrush x:Key="ToggleSwitchFillOffPointerOver" Color="#FF444852" />
    <SolidColorBrush x:Key="ToggleSwitchFillOffPressed" Color="#FF343741" />
    <SolidColorBrush x:Key="ToggleSwitchFillOffDisabled" Color="#FF2A2C33" />
    <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="#FF6E7686" />
    <SolidColorBrush x:Key="ToggleSwitchStrokeOffPointerOver" Color="#FF9AA6B2" />
    <SolidColorBrush x:Key="ToggleSwitchStrokeOffPressed" Color="#FF9AA6B2" />
    <SolidColorBrush x:Key="ToggleSwitchStrokeOffDisabled" Color="#FF3A3D46" />
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="#FFB9C2CB" />
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPointerOver" Color="#FFEDF1F5" />
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPressed" Color="#FFEDF1F5" />
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOffDisabled" Color="#FF5A6068" />
    <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#FF6FD0FA" />
    <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#FF3FB2E8" />
    <SolidColorBrush x:Key="ToggleSwitchFillOnDisabled" Color="#FF2C6C8A" />
    <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="Transparent" />
    <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="Transparent" />
    <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed" Color="Transparent" />
    <SolidColorBrush x:Key="ToggleSwitchStrokeOnDisabled" Color="Transparent" />
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#FF10222E" />
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#FF10222E" />
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#FF10222E" />
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOnDisabled" Color="#FF3A3D46" />
    <SolidColorBrush x:Key="ToggleSwitchContentForeground" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="ToggleSwitchHeaderForeground" Color="{StaticResource TextPrimaryColor}" />

    <!-- 下拉框 -->
    <SolidColorBrush x:Key="ComboBoxBackground" Color="#FF2C2F37" />
    <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#FF343741" />
    <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#FF3C3F49" />
    <SolidColorBrush x:Key="ComboBoxBackgroundFocused" Color="#FF2C2F37" />
    <SolidColorBrush x:Key="ComboBoxBackgroundUnfocused" Color="#FF2C2F37" />
    <SolidColorBrush x:Key="ComboBoxBackgroundDisabled" Color="#FF232529" />
    <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#FF3C3F48" />
    <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#FF4A4F5A" />
    <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="#FF4A4F5A" />
    <SolidColorBrush x:Key="ComboBoxBorderBrushDisabled" Color="#FF2A2C33" />
    <SolidColorBrush x:Key="ComboBoxForeground" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="ComboBoxForegroundPointerOver" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="ComboBoxForegroundPressed" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="ComboBoxForegroundFocused" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="ComboBoxForegroundFocusedPressed" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="ComboBoxForegroundDisabled" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#FF23252B" />
    <SolidColorBrush x:Key="ComboBoxDropDownBackgroundPointerOver" Color="#FF2E313A" />
    <SolidColorBrush x:Key="ComboBoxDropDownBackgroundPointerPressed" Color="#FF353943" />
    <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#FF3C3F48" />
    <SolidColorBrush x:Key="ComboBoxDropDownForeground" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="ComboBoxDropDownGlyphForeground" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="ComboBoxDropDownGlyphForegroundFocused" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="ComboBoxDropDownGlyphForegroundFocusedPressed" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="ComboBoxDropDownGlyphForegroundDisabled" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="ComboBoxItemBackground" Color="Transparent" />
    <SolidColorBrush x:Key="ComboBoxItemBackgroundPointerOver" Color="#FF2E313A" />
    <SolidColorBrush x:Key="ComboBoxItemBackgroundPressed" Color="#FF353943" />
    <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="#FF33414D" />
    <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPointerOver" Color="#FF3A4A57" />
    <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPressed" Color="#FF3F5060" />
    <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedUnfocused" Color="#FF33414D" />
    <SolidColorBrush x:Key="ComboBoxItemForeground" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="ComboBoxItemForegroundPointerOver" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="ComboBoxItemForegroundPressed" Color="{StaticResource TextPrimaryColor}" />

    <!-- 输入框 -->
    <SolidColorBrush x:Key="TextControlBackground" Color="#FF2C2F37" />
    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#FF343741" />
    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#FF2C2F37" />
    <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="#FF232529" />
    <SolidColorBrush x:Key="TextControlBorderBrush" Color="#FF3C3F48" />
    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#FF4A4F5A" />
    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="#FF2A2C33" />
    <SolidColorBrush x:Key="TextControlElevationBorderBrush" Color="#FF3C3F48" />
    <SolidColorBrush x:Key="TextControlElevationBorderFocusedBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="TextControlForeground" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextControlForegroundFocused" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextControlForegroundDisabled" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#FF8C97A3" />
    <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#FF9AA6B2" />
    <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#FF8C97A3" />
    <SolidColorBrush x:Key="TextControlPlaceholderForegroundDisabled" Color="#FF6E7686" />
    <SolidColorBrush x:Key="TextControlButtonBackground" Color="Transparent" />
    <SolidColorBrush x:Key="TextControlButtonBackgroundPointerOver" Color="#FF343741" />
    <SolidColorBrush x:Key="TextControlButtonBackgroundPressed" Color="#FF3C3F49" />
    <SolidColorBrush x:Key="TextControlButtonForeground" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextControlButtonForegroundPointerOver" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextControlButtonForegroundPressed" Color="{StaticResource TextPrimaryColor}" />

    <!-- 滑块 -->
    <SolidColorBrush x:Key="SliderTrackFill" Color="#FF3A3D46" />
    <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="#FF444852" />
    <SolidColorBrush x:Key="SliderTrackFillPressed" Color="#FF343741" />
    <SolidColorBrush x:Key="SliderTrackFillDisabled" Color="#FF2A2C33" />
    <SolidColorBrush x:Key="SliderTrackValueFill" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#FF6FD0FA" />
    <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#FF3FB2E8" />
    <SolidColorBrush x:Key="SliderTrackValueFillDisabled" Color="#FF2C6C8A" />
    <SolidColorBrush x:Key="SliderThumbBackground" Color="#FFCFD8E3" />
    <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#FFEDF1F5" />
    <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#FFEDF1F5" />
    <SolidColorBrush x:Key="SliderThumbBackgroundDisabled" Color="#FF5A6068" />
    <SolidColorBrush x:Key="SliderOuterThumbBackground" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="SliderContainerBackground" Color="Transparent" />
    <SolidColorBrush x:Key="SliderContainerBackgroundPointerOver" Color="Transparent" />
    <SolidColorBrush x:Key="SliderContainerBackgroundPressed" Color="Transparent" />
    <SolidColorBrush x:Key="SliderContainerBackgroundDisabled" Color="Transparent" />
    <SolidColorBrush x:Key="SliderHeaderForeground" Color="{StaticResource TextPrimaryColor}" />

    <!-- 进度条 -->
    <SolidColorBrush x:Key="ProgressBarBackground" Color="#FF2C2F37" />
    <SolidColorBrush x:Key="ProgressBarForeground" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="ProgressBarBorderBrush" Color="Transparent" />

    <!--
         普通按钮 / 主按钮的悬停态。
         这两个按钮的样式里写死了底色和文字色，但 WinUI 模板的 PointerOver 状态
         会用主题资源覆盖它们；浅色系统主题下这些资源是"白底黑字"，于是鼠标一
         停留文字就变黑。这里全部改成深色界面该有的灰底白字。
    -->
    <SolidColorBrush x:Key="ButtonBackground" Color="#FF2C2F37" />
    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#FF3A3E48" />
    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#FF454A55" />
    <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#FF232529" />
    <SolidColorBrush x:Key="ButtonForeground" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#FF6E7686" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
    <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="Transparent" />

    <SolidColorBrush x:Key="AccentButtonBackground" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#FF6FD0FA" />
    <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#FF3FB2E8" />
    <SolidColorBrush x:Key="AccentButtonBackgroundDisabled" Color="#FF2C6C8A" />
    <SolidColorBrush x:Key="AccentButtonForeground" Color="#FF10222E" />
    <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#FF10222E" />
    <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#FF10222E" />
    <SolidColorBrush x:Key="AccentButtonForegroundDisabled" Color="#FF3A3D46" />
    <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="Transparent" />
    <SolidColorBrush x:Key="AccentButtonBorderBrushPointerOver" Color="Transparent" />
    <SolidColorBrush x:Key="AccentButtonBorderBrushPressed" Color="Transparent" />
    <SolidColorBrush x:Key="AccentButtonBorderBrushDisabled" Color="Transparent" />

    <!-- 列表选中态（浅色主题下原本是白 / 浅蓝横条） -->
    <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="#FF2E313A" />
    <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="#FF353943" />
    <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#FF33414D" />
    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#FF3A4A57" />
    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="#FF3F5060" />
    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedDisabled" Color="#FF2A2C33" />
    <SolidColorBrush x:Key="ListViewItemForegroundSelected" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="ListViewItemForegroundSelectedPointerOver" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="ListViewItemForegroundSelectedPressed" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="ListViewItemSelectionIndicatorBrush" Color="{StaticResource AccentColor}" />

    <!--
         GridView 的条目底色铺在"卡片 + 卡片外边距"整块区域上，而卡片自带右/下
         外边距，看起来就是一块对不齐的阴影。这里改成透明，悬停反馈交给卡片自身。
    -->
    <SolidColorBrush x:Key="GridViewItemBackground" Color="Transparent" />
    <SolidColorBrush x:Key="GridViewItemBackgroundPointerOver" Color="Transparent" />
    <SolidColorBrush x:Key="GridViewItemBackgroundPressed" Color="Transparent" />
    <SolidColorBrush x:Key="GridViewItemBackgroundSelected" Color="Transparent" />
    <SolidColorBrush x:Key="GridViewItemBackgroundSelectedPointerOver" Color="Transparent" />
    <SolidColorBrush x:Key="GridViewItemBackgroundSelectedPressed" Color="Transparent" />
    <SolidColorBrush x:Key="GridViewItemBackgroundSelectedDisabled" Color="Transparent" />
    <!--
         GridView 条目的焦点框/悬停框/选中框同样画在"卡片 + 外边距"整块区域上，
         深色主题里 FocusStrokeColorOuter 还是黑色，于是卡片外面多出一个黑框。
         卡片自己已经有边框，这些条目级别的框全部去掉。
    -->
    <SolidColorBrush x:Key="GridViewItemFocusBorderBrush" Color="Transparent" />
    <SolidColorBrush x:Key="GridViewItemPointerOverBorderBrush" Color="Transparent" />
    <SolidColorBrush x:Key="GridViewItemSelectedBorderBrush" Color="Transparent" />
    <SolidColorBrush x:Key="GridViewItemSelectedPointerOverBorderBrush" Color="Transparent" />
    <SolidColorBrush x:Key="GridViewItemSelectedPressedBorderBrush" Color="Transparent" />
    <SolidColorBrush x:Key="GridViewItemSelectedDisabledBorderBrush" Color="Transparent" />
    <SolidColorBrush x:Key="GridViewItemSelectedInnerBorderBrush" Color="Transparent" />
    <SolidColorBrush x:Key="GridViewItemFocusVisualPrimaryBrush" Color="Transparent" />
    <SolidColorBrush x:Key="GridViewItemFocusVisualSecondaryBrush" Color="Transparent" />
    <Thickness x:Key="GridViewItemSelectedBorderThickness">0</Thickness>

    <!--
         勾选框用自定义模板：框架模板的"未选中"在深色主题下是透明方框，落在深色
         卡片上看起来就是个黑框。这里固定成"灰色方框 + 浅灰描边 + 选中时主色 + 勾"，
         并且整个控件没有额外底色，不会有错位的灰底/黑框。
    -->
    <Style TargetType="CheckBox">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="10,0,0,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Box" Width="20" Height="20" CornerRadius="4"
                                Background="#FF3A3D46" BorderBrush="#FF7A8496"
                                BorderThickness="1" VerticalAlignment="Center">
                            <FontIcon x:Name="Tick" Glyph="&#xE73E;" FontSize="12"
                                      Foreground="#FF10222E" Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter x:Name="Label" Grid.Column="1"
