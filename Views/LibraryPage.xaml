<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="BukaMusicDesktop.Views.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:BukaMusicDesktop.Core"
    xmlns:controls="using:BukaMusicDesktop.Controls"
    Background="{StaticResource BgBrush}">

    <Page.Resources>
        <!-- 右键曲目时的菜单；具体条目在打开时按当前设备名生成 -->
        <MenuFlyout x:Key="TrackMenu" Opening="OnTrackMenuOpening" />
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource SectionCardStyle}">
            <StackPanel Spacing="12">
                <!-- The count sits next to the title so it always has room and
                     scrolls on its own when the library is bigger than the row. -->
                <Grid>
                    <TextBlock Text="曲库与文件" HorizontalAlignment="Left"
                               Style="{StaticResource SectionTitleStyle}" />
                    <controls:MarqueeText x:Name="CountText" Text=""
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Top"
                                          TextAlignment="Right" Margin="160,0,0,0"
                                          Style="{StaticResource MarqueeLabelStyle}" />
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBox x:Name="SearchBox" Width="240" Height="34"
                             PlaceholderText="歌曲名"
                             TextChanged="OnSearchChanged" />
                    <ComboBox x:Name="GroupCombo" Width="150" Height="34"
                              SelectionChanged="OnGroupChanged">
                        <ComboBoxItem Content="默认顺序" Tag="none" />
                        <ComboBoxItem Content="按专辑" Tag="album" />
                        <ComboBoxItem Content="按歌手" Tag="artist" />
                    </ComboBox>
                    <Button Content="上传音乐" Style="{StaticResource AccentButtonStyle}"
                            Click="OnUpload" />
                    <Button x:Name="ManageButton" Content="管理"
                            Style="{StaticResource GhostButtonStyle}" Click="OnManage" />
                    <Button x:Name="DeleteButton" Content="删除所选" IsEnabled="False"
                            Visibility="Collapsed"
                            Style="{StaticResource DangerButtonStyle}" Click="OnDelete" />
                    <Button Content="刷新列表" Style="{StaticResource GhostButtonStyle}"
                            Click="OnRefresh" />
                </StackPanel>
                <controls:MarqueeText x:Name="UploadStatus" Text="" MaxWidth="460"
                                      FontFamily="{StaticResource UiFont}" FontSize="12"
                                      Foreground="{StaticResource TextSecondaryBrush}" />
                <ProgressBar x:Name="UploadProgress" Minimum="0" Maximum="100"
                             Visibility="Collapsed" Height="4" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 打开某张专辑 / 某位歌手后的返回条 -->
                <StackPanel x:Name="GroupHeaderBar" Grid.Row="0" Orientation="Horizontal"
                            Spacing="12" Padding="12,8,12,10" Visibility="Collapsed">
                    <Button Content="← 返回" Style="{StaticResource GhostButtonStyle}"
                            Click="OnBackToGroups" />
                    <controls:MarqueeText x:Name="GroupTitleText" Text="" MaxWidth="560"
                                          FontFamily="{StaticResource UiFont}" FontSize="15"
                                          FontWeight="SemiBold"
                                          Foreground="{StaticResource TextPrimaryBrush}" />
                    <controls:MarqueeText x:Name="GroupSubtitleText" Text="" MaxWidth="200"
                                          Style="{StaticResource MarqueeLabelStyle}" />
                </StackPanel>

                <!-- 与行模板使用完全相同的列宽与内边距，保证各列上下对齐 -->
                <Grid x:Name="ListHeaderRow" Grid.Row="1" Padding="12,10,12,10"
                      ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="76" />
                        <ColumnDefinition Width="96" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="HeaderTitle" Grid.Column="0" Text="标题 / 文件名" VerticalAlignment="Center"
                               Style="{StaticResource LabelTextStyle}" />
                    <TextBlock x:Name="HeaderArtist" Grid.Column="1" Text="歌手" VerticalAlignment="Center"
                               Style="{StaticResource LabelTextStyle}" />
                    <TextBlock x:Name="HeaderAlbum" Grid.Column="2" Text="专辑" VerticalAlignment="Center"
                               Style="{StaticResource LabelTextStyle}" />
                    <TextBlock x:Name="HeaderDuration" Grid.Column="3" Text="时长" VerticalAlignment="Center"
                               TextAlignment="Right"
                               Style="{StaticResource LabelTextStyle}" />
                    <TextBlock x:Name="HeaderSize" Grid.Column="4" Text="大小" VerticalAlignment="Center"
                               TextAlignment="Right"
                               Style="{StaticResource LabelTextStyle}" />
                </Grid>

                <ListView x:Name="TrackList" Grid.Row="2" SelectionMode="None"
                          IsItemClickEnabled="True" ItemClick="OnTrackClick"
                          SelectionChanged="OnSelectionChanged">
                    <!-- 容器自带 16/12 的内边距，会让数据行比表头窄 28 像素、
                         各列整体左移；清零后与表头逐列对齐。 -->
                    <ListView.Resources>
                        <!-- 悬停 / 选中底色由 ListViewItemPresenter 绘制，它的圆角
                             取的是这个主题资源，只在列表范围内覆盖，避免影响其它控件。 -->
                        <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
                    </ListView.Resources>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,1,0,1" />
                            <Setter Property="MinHeight" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <!-- 默认模板的底色由 ListViewItemPresenter 绘制，它的圆角固定取
                                 主题资源、不受样式影响，所以这里用自定义模板自己画底色。 -->
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <Grid x:Name="RowRoot" CornerRadius="8"
                                              Background="Transparent"
                                              ContextFlyout="{StaticResource TrackMenu}">
                                            <VisualStateManager.VisualStateGroups>
                                                <VisualStateGroup x:Name="CommonStates">
                                                    <VisualState x:Name="Normal" />
                                                    <VisualState x:Name="PointerOver">
                                                        <VisualState.Setters>
                                                            <Setter Target="RowRoot.Background"
                                                                    Value="{StaticResource CardHoverBrush}" />
                                                        </VisualState.Setters>
                                                    </VisualState>
                                                    <VisualState x:Name="Pressed">
                                                        <VisualState.Setters>
                                                            <Setter Target="RowRoot.Background"
                                                                    Value="{StaticResource CardBrush}" />
                                                        </VisualState.Setters>
                                                    </VisualState>
                                                    <VisualState x:Name="Selected" />
                                                    <VisualState x:Name="PointerOverSelected" />
                                                    <VisualState x:Name="PressedSelected" />
                                                    <VisualState x:Name="Disabled" />
                                                </VisualStateGroup>
                                            </VisualStateManager.VisualStateGroups>
                                            <ContentPresenter Content="{TemplateBinding Content}"
                                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                                              Padding="{TemplateBinding Padding}"
                                                              HorizontalAlignment="Stretch"
                                                              VerticalAlignment="Center" />
                                        </Grid>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="core:TrackItem">
                            <!-- 与表头保持同样的列宽、内边距与列间距 -->
                            <Grid Padding="13,7,12,7" ColumnSpacing="14"
                                  Background="Transparent"
                                  RightTapped="OnTrackRightTapped"
                                  ContextFlyout="{StaticResource TrackMenu}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="76" />
                                    <ColumnDefinition Width="96" />
                                </Grid.ColumnDefinitions>
                                <!-- 勾选框单独占一列：出现时标题与下方路径一起右移，
                                     两行始终左对齐；不显示时该列宽度为 0。 -->
                                <Grid Grid.Column="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0"
                                              IsChecked="{x:Bind IsChecked, Mode=OneWay}"
                                              Visibility="{x:Bind CheckVisibility, Mode=OneWay}"
                                              MinWidth="0" Margin="0,0,2,0"
                                              VerticalAlignment="Center"
                                              IsHitTestVisible="False" />
                                    <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE768;" FontSize="11"
                                                      Visibility="{x:Bind CurrentVisibility, Mode=OneWay}"
                                                      Foreground="{StaticResource AccentBrush}"
                                                      VerticalAlignment="Center" />
                                            <controls:MarqueeText Text="{x:Bind Display}"
                                                                  FontFamily="{StaticResource UiFont}"
                                                                  FontSize="13"
                                                                  Foreground="{x:Bind TitleBrush, Mode=OneWay}"
                                                                  VerticalAlignment="Center" />
                                        </StackPanel>
                                        <controls:MarqueeText Text="{x:Bind RelativePath}"
                                                              Margin="0,2,0,0"
                                                              FontFamily="Consolas" FontSize="11"
                                                              Foreground="{StaticResource TextSecondaryBrush}" />
                                    </StackPanel>
                                </Grid>
                                <controls:MarqueeText Grid.Column="1" Text="{x:Bind Artist}"
                                                      Style="{StaticResource MarqueeValueStyle}"
                                                      VerticalAlignment="Center" />
                                <controls:MarqueeText Grid.Column="2" Text="{x:Bind Album}"
                                                      Style="{StaticResource MarqueeValueStyle}"
                                                      VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="{x:Bind DurationText}"
                                           VerticalAlignment="Center" TextAlignment="Right"
                                           Style="{StaticResource LabelTextStyle}" />
                                <TextBlock Grid.Column="4" Text="{x:Bind SizeText}"
                                           VerticalAlignment="Center" TextAlignment="Right"
                                           Style="{StaticResource LabelTextStyle}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- 专辑 / 歌手浏览：先看图片和名字，点进去才是歌曲 -->
                <GridView x:Name="GroupGrid" Grid.Row="1" Grid.RowSpan="2"
                          Padding="6" Visibility="Collapsed"
                          SelectionMode="None" IsItemClickEnabled="True"
                          SelectionChanged="OnGroupSelectionChanged"
                          ItemClick="OnGroupTileClick">
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="core:GroupTile">
                            <StackPanel Width="166" Spacing="8" Padding="4,4,4,10">
                                <Border Width="158" Height="158" CornerRadius="10"
                                        Background="{StaticResource CardHoverBrush}">
                                    <Grid>
                                        <Image Source="{x:Bind Cover, Mode=OneWay}"
                                               Stretch="UniformToFill" />
                                        <!-- 勾选框只在「管理」模式下出现 -->
                                        <CheckBox IsChecked="{x:Bind IsChecked, Mode=OneWay}"
                                                  Visibility="{x:Bind CheckVisibility, Mode=OneWay}"
                                                  MinWidth="0" Margin="8,8,0,0"
                                                  HorizontalAlignment="Left"
                                                  VerticalAlignment="Top"
                                                  IsHitTestVisible="False" />
                                    </Grid>
                                </Border>
                                <controls:MarqueeText Text="{x:Bind Title}"
                                                      FontFamily="{StaticResource UiFont}"
                                                      FontSize="13" FontWeight="SemiBold"
                                                      Foreground="{StaticResource TextPrimaryBrush}" />
                                <controls:MarqueeText Text="{x:Bind Subtitle}"
                                                      Style="{StaticResource MarqueeLabelStyle}" />
                            </StackPanel>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>

                <TextBlock x:Name="LoadingText" Grid.Row="2" Text="正在读取曲库…"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Style="{StaticResource LabelTextStyle}" />
            </Grid>
        </Border>
    </Grid>
</Page>
