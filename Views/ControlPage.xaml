<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="BukaMusicDesktop.Views.ControlPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:BukaMusicDesktop.Controls"
    Background="{StaticResource BgBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <!-- 正在播放 -->
            <Border Style="{StaticResource SectionCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="170" Height="170" CornerRadius="8"
                            Background="#FF1A1C21" BorderBrush="{StaticResource StrokeBrush}"
                            BorderThickness="1">
                        <Grid>
                            <FontIcon Glyph="&#xE8D6;" FontSize="42"
                                      Foreground="{StaticResource TextSecondaryBrush}" />
                            <Image x:Name="CoverImage" Stretch="UniformToFill" />
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="22,6,0,0" Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Background="{StaticResource AccentDimBrush}" CornerRadius="5"
                                    Padding="9,4">
                                <TextBlock x:Name="SourceText" Text="未在播放"
                                           FontFamily="{StaticResource UiFont}" FontSize="12"
                                           Foreground="{StaticResource TextPrimaryBrush}" />
                            </Border>
                            <controls:MarqueeText x:Name="StatusText" Text="" MaxWidth="360"
                                                  FontFamily="{StaticResource UiFont}" FontSize="12"
                                                  Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>

                        <controls:MarqueeText x:Name="TitleText" Text="—"
                                              FontFamily="{StaticResource UiFont}" FontSize="24"
                                              FontWeight="SemiBold"
                                              Foreground="{StaticResource TextPrimaryBrush}" />
                        <controls:MarqueeText x:Name="ArtistText" Text=""
                                              FontFamily="{StaticResource UiFont}" FontSize="14"
                                              Foreground="{StaticResource AccentBrush}" />
                        <controls:MarqueeText x:Name="AlbumText" Text=""
                                              FontFamily="{StaticResource UiFont}" FontSize="12"
                                              Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 播放控制 -->
            <Border Style="{StaticResource SectionCardStyle}">
                <StackPanel Spacing="14">
                    <Grid x:Name="ProgressRow">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="PositionText" Grid.Column="0" Text="0:00"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource LabelTextStyle}" />
                        <Slider x:Name="ProgressSlider" Grid.Column="1" Minimum="0" Maximum="1000"
                                Margin="12,0,12,0" VerticalAlignment="Center"
                                ValueChanged="OnProgressChanged" />
                        <TextBlock x:Name="DurationText" Grid.Column="2" Text="0:00"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource LabelTextStyle}" />
                    </Grid>

                    <TextBlock x:Name="AirPlayHint" Text="AirPlay 播放进度由发送端（手机）控制，此处不显示进度条"
                               Visibility="Collapsed" HorizontalAlignment="Center"
                               Style="{StaticResource HintTextStyle}" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="16">
                        <Button x:Name="PrevButton" Click="OnPrevious"
                                Style="{StaticResource GhostButtonStyle}" Padding="16,10">
                            <FontIcon Glyph="&#xE892;" FontSize="18" />
                        </Button>
                        <Button x:Name="PlayButton" Click="OnTogglePlay"
                                Style="{StaticResource AccentButtonStyle}" Padding="24,12">
                            <FontIcon x:Name="PlayIcon" Glyph="&#xE768;" FontSize="22" />
                        </Button>
                        <Button x:Name="NextButton" Click="OnNext"
                                Style="{StaticResource GhostButtonStyle}" Padding="16,10">
                            <FontIcon Glyph="&#xE893;" FontSize="18" />
                        </Button>
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE767;" FontSize="14"
                                  VerticalAlignment="Center"
                                  Foreground="{StaticResource TextSecondaryBrush}" />
                        <Slider x:Name="VolumeSlider" Grid.Column="1" Margin="10,0,10,0"
                                Minimum="0" Maximum="40" StepFrequency="1"
                                ValueChanged="OnVolumeChanged" />
                        <TextBlock x:Name="VolumeText" Grid.Column="2" Text="0"
                                   VerticalAlignment="Center" MinWidth="44"
                                   TextAlignment="Right"
                                   Style="{StaticResource LabelTextStyle}" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10">
                        <Button Content="重新扫描音乐" Style="{StaticResource GhostButtonStyle}"
                                Click="OnRescan" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 播放方式与维护已移到「设置」页，这里只保留进度、播放/暂停与系统音量。 -->

            <!-- 电脑端本地播放：在电脑上播放设备里的歌曲（音频来自设备，
                 与上面的设备控制互不影响） -->
            <Border Style="{StaticResource SectionCardStyle}">
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="电脑播放" Style="{StaticResource SectionTitleStyle}"
                                   Margin="0" />
                        <TextBlock x:Name="LocalHintText" Text="左键点击曲库里的歌曲即在此播放"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource HintTextStyle}" />
                    </StackPanel>

                    <controls:MarqueeText x:Name="LocalTrackText" Text="未在播放"
                                          Style="{StaticResource MarqueeValueStyle}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="LocalPositionText" Grid.Column="0" Text="0:00"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource LabelTextStyle}" />
                        <Slider x:Name="LocalProgressSlider" Grid.Column="1"
                                Minimum="0" Maximum="1000" Margin="12,0,12,0"
                                VerticalAlignment="Center"
                                ValueChanged="OnLocalProgressChanged" />
                        <TextBlock x:Name="LocalDurationText" Grid.Column="2" Text="0:00"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource LabelTextStyle}" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="16">
                        <Button x:Name="LocalPrevButton" Click="OnLocalPrevious"
                                Style="{StaticResource GhostButtonStyle}" Padding="16,10">
                            <FontIcon Glyph="&#xE892;" FontSize="18" />
                        </Button>
                        <Button x:Name="LocalPlayButton" Click="OnLocalToggle"
                                Style="{StaticResource AccentButtonStyle}" Padding="24,12">
                            <FontIcon x:Name="LocalPlayIcon" Glyph="&#xE768;" FontSize="22" />
                        </Button>
                        <Button x:Name="LocalNextButton" Click="OnLocalNext"
                                Style="{StaticResource GhostButtonStyle}" Padding="16,10">
                            <FontIcon Glyph="&#xE893;" FontSize="18" />
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
