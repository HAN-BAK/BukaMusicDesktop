<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="BukaMusicDesktop.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:BukaMusicDesktop.Controls"
    Background="{StaticResource BgBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <Border Style="{StaticResource SectionCardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="设备与曲库" Style="{StaticResource SectionTitleStyle}" />

                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="设备名称" VerticalAlignment="Center"
                                   Style="{StaticResource LabelTextStyle}" />
                        <TextBox x:Name="DeviceNameBox" Grid.Column="1" Height="34" />
                    </Grid>

                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="音乐文件夹" VerticalAlignment="Center"
                                   Style="{StaticResource LabelTextStyle}" />
                        <TextBox x:Name="FolderBox" Grid.Column="1" Height="34" />
                    </Grid>
                    <TextBlock Style="{StaticResource HintTextStyle}"
                               Text="音乐文件夹需填写设备上的绝对路径，例如 /storage/emulated/0/Music 或 U 盘挂载路径；修改后设备会自动重新扫描。" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SectionCardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="播放" Style="{StaticResource SectionTitleStyle}" />

                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="播放方式" VerticalAlignment="Center"
                                   Style="{StaticResource LabelTextStyle}" />
                        <ComboBox x:Name="ModeCombo" Grid.Column="1" Width="190" Height="36">
                            <ComboBoxItem Content="顺序播放" Tag="SEQUENCE" />
                            <ComboBoxItem Content="顺序循环播放" Tag="FOLDER_LOOP" />
                            <ComboBoxItem Content="随机循环播放" Tag="SHUFFLE" />
                            <ComboBoxItem Content="单曲循环" Tag="REPEAT_ONE" />
                        </ComboBox>
                    </Grid>

                    <ToggleSwitch x:Name="AutoPlaySwitch" Header="启动应用时自动播放本地音乐" />

                    <StackPanel Spacing="4">
                        <TextBlock Text="左右声道平衡（-1 左 / +1 右）"
                                   Style="{StaticResource LabelTextStyle}" />
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="60" />
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="BalanceSlider" Grid.Column="0" Minimum="-1" Maximum="1"
                                    StepFrequency="0.05" ValueChanged="OnBalanceChanged" />
                            <TextBlock x:Name="BalanceText" Grid.Column="1" Text="0.00"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource LabelTextStyle}" />
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SectionCardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="界面与语言" Style="{StaticResource SectionTitleStyle}" />

                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="背景模糊" VerticalAlignment="Center"
                                   Style="{StaticResource LabelTextStyle}" />
                        <ComboBox x:Name="BlurCombo" Grid.Column="1" Width="150" Height="36">
                            <ComboBoxItem Content="深色" Tag="dark" />
                            <ComboBoxItem Content="关闭" Tag="off" />
                        </ComboBox>
                    </Grid>

                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="语言" VerticalAlignment="Center"
                                   Style="{StaticResource LabelTextStyle}" />
                        <ComboBox x:Name="LanguageCombo" Grid.Column="1" Width="150" Height="36">
                            <ComboBoxItem Content="中文" Tag="zh" />
                            <ComboBoxItem Content="English" Tag="en" />
                            <ComboBoxItem Content="日本語" Tag="ja" />
                            <ComboBoxItem Content="한국어" Tag="ko" />
                        </ComboBox>
                    </Grid>

                    <ToggleSwitch x:Name="AppsButtonSwitch" Header="播放界面显示应用列表按钮" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SectionCardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="在线歌词" Style="{StaticResource SectionTitleStyle}" />
                    <ToggleSwitch x:Name="OnlineLyricsSwitch"
                                  Header="自动在线获取歌词与歌曲信息" />
                    <TextBlock Style="{StaticResource HintTextStyle}"
                               Text="本地歌词没有词级时间戳、或歌曲缺少标签/封面时，自动从网易云音乐（备用 LRCLIB）补全；仅用于显示，不改动歌曲文件。" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SectionCardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="均衡器（10 频段，dB）" Style="{StaticResource SectionTitleStyle}" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="保存预设" Style="{StaticResource GhostButtonStyle}"
                                Click="OnSavePreset" />
                        <Button Content="加载预设" Style="{StaticResource GhostButtonStyle}"
                                Click="OnLoadPreset" />
                        <Button Content="删除预设" Style="{StaticResource GhostButtonStyle}"
                                Click="OnDeletePreset" />
                        <Button Content="导出预设" Style="{StaticResource GhostButtonStyle}"
                                Click="OnExportPresets" />
                        <Button Content="导入预设" Style="{StaticResource GhostButtonStyle}"
                                Click="OnImportPresets" />
                        <Button Content="恢复默认" Style="{StaticResource GhostButtonStyle}"
                                Click="OnResetEq" />
                    </StackPanel>
                    <controls:MarqueeText x:Name="EqPresetHint" Text="" MaxWidth="640"
                                          FontFamily="{StaticResource UiFont}" FontSize="12"
                                          Foreground="{StaticResource TextSecondaryBrush}" />
                    <ItemsControl x:Name="EqList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="core:EqBand"
                                          xmlns:core="using:BukaMusicDesktop.Core">
                                <StackPanel Width="86" Spacing="4" Margin="0,0,6,0">
                                    <TextBlock Text="{x:Bind Frequency}" HorizontalAlignment="Center"
                                               Style="{StaticResource LabelTextStyle}" />
                                    <Slider Orientation="Vertical" Height="150" Minimum="-12" Maximum="12"
                                            StepFrequency="0.1" Value="{x:Bind Gain, Mode=TwoWay}" />
                                    <TextBlock Text="{x:Bind GainText, Mode=OneWay}"
                                               HorizontalAlignment="Center"
                                               FontFamily="Consolas" FontSize="12"
                                               Foreground="{StaticResource AccentBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SectionCardStyle}">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Content="保存设置" Style="{StaticResource AccentButtonStyle}"
                            Click="OnSave" />
                    <Button Content="重新读取" Style="{StaticResource GhostButtonStyle}"
                            Click="OnReload" />
                    <controls:MarqueeText x:Name="SaveStatus" Text="" MaxWidth="640"
                                          FontFamily="{StaticResource UiFont}" FontSize="12"
                                          Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
