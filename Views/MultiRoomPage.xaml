<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="BukaMusicDesktop.Views.MultiRoomPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:BukaMusicDesktop.Controls"
    Background="{StaticResource BgBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource SectionCardStyle}">
            <StackPanel Spacing="10">
                <TextBlock Text="多房间同步" Style="{StaticResource SectionTitleStyle}" />
                <controls:MarqueeText x:Name="RoomStatusText" Text="正在读取…"
                                      Style="{StaticResource MarqueeValueStyle}" />
                <TextBlock Style="{StaticResource HintTextStyle}"
                           Text="勾选要同步的设备后点「应用」：本机（主控）播放的本地音乐会同时推送到这些设备。取消勾选即断开该设备，" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button x:Name="ApplyButton" Content="应用" Style="{StaticResource AccentButtonStyle}"
                            Click="OnApply" />
                    <Button x:Name="ClearButton" Content="全部断开" Style="{StaticResource DangerButtonStyle}"
                            Click="OnClear" />
                    <Button x:Name="RefreshButton" Content="刷新" Style="{StaticResource GhostButtonStyle}"
                            Click="OnRefresh" />
                    <Button x:Name="DisconnectReceiverButton" Content="断开多房间连接"
                            Style="{StaticResource DangerButtonStyle}"
                            Visibility="Collapsed" Click="OnDisconnectReceiver" />
                    <TextBlock x:Name="HintText" Text="" VerticalAlignment="Center"
                               Style="{StaticResource LabelTextStyle}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border x:Name="DeviceCard" Grid.Row="1" Style="{StaticResource CardStyle}" Padding="10">
            <Grid>
                <ListView x:Name="DeviceList" SelectionMode="None">
                    <!-- The list is refreshed every five seconds; without this the
                         ListView replays its add/remove transition on every poll,
                         which shows up as the whole list flashing. -->
                    <ListView.ItemContainerTransitions>
                        <TransitionCollection />
                    </ListView.ItemContainerTransitions>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="core:MultiRoomDevice"
                                      xmlns:core="using:BukaMusicDesktop.Core">
                            <Grid Padding="6,8,6,8" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" IsChecked="{x:Bind Selected, Mode=TwoWay}"
                                          IsEnabled="{x:Bind HasIpv4}" MinWidth="0" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <controls:MarqueeText Text="{x:Bind Name}"
                                                          FontFamily="{StaticResource UiFont}"
                                                          FontSize="14"
                                                          Foreground="{StaticResource TextPrimaryBrush}" />
                                    <controls:MarqueeText Text="{x:Bind AddressText}"
                                                          FontFamily="Consolas" FontSize="11"
                                                          Foreground="{StaticResource TextSecondaryBrush}" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{x:Bind StatusText}"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource LabelTextStyle}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock x:Name="EmptyHint" Text="没有发现可同步的设备"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Style="{StaticResource LabelTextStyle}" />
            </Grid>
        </Border>
    </Grid>
</Page>
