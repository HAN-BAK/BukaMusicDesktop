<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="BukaMusicDesktop.Views.LogsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource BgBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource SectionCardStyle}">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="运行日志" Style="{StaticResource SectionTitleStyle}"
                           VerticalAlignment="Center" Margin="0" />
                <Button Content="清空" Style="{StaticResource GhostButtonStyle}"
                        Click="OnClear" />
                <TextBlock x:Name="CountText" Text="" VerticalAlignment="Center"
                           Style="{StaticResource LabelTextStyle}" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="10">
            <ListView x:Name="LogList" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="core:LogEntry"
                                  xmlns:core="using:BukaMusicDesktop.Core">
                        <Grid Padding="2,4,2,4" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="52" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{x:Bind TimeText}"
                                       FontFamily="Consolas" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Grid.Column="1" Text="{x:Bind LevelText}"
                                       FontFamily="Consolas" FontSize="12"
                                       Foreground="{x:Bind LevelBrush}" />
                            <TextBlock Grid.Column="2" Text="{x:Bind Message}"
                                       FontFamily="{StaticResource UiFont}" FontSize="12"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>
    </Grid>
</Page>
