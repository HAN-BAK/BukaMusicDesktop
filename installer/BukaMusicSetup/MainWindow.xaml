<Window x:Class="BukaMusicSetup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BukaMusic 控制台 安装程序"
        Width="660" Height="440"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        FontFamily="Microsoft YaHei UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <!-- 圆角窗口：透明窗口 + 圆角边框 -->
    <Border CornerRadius="10" Background="#1B1C21" BorderBrush="#34363F"
            BorderThickness="1" MouseLeftButtonDown="OnDrag">
    <Grid ClipToBounds="True">
        <Grid.Clip>
            <RectangleGeometry Rect="0,0,658,438" RadiusX="10" RadiusY="10" />
        </Grid.Clip>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="212" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左侧品牌区 -->
        <Border Grid.Column="0" CornerRadius="10,0,0,10">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#1D4459" Offset="0" />
                    <GradientStop Color="#16262F" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <StackPanel VerticalAlignment="Center" Margin="24,0">
                <Image Source="Assets/logo.png" Width="76" Height="76"
                       Stretch="UniformToFill" HorizontalAlignment="Left">
                    <Image.Clip>
                        <RectangleGeometry Rect="0,0,76,76" RadiusX="18" RadiusY="18" />
                    </Image.Clip>
                </Image>
                <TextBlock Text="BukaMusic" FontSize="24" FontWeight="SemiBold"
                           Foreground="White" Margin="0,18,0,2" />
                <TextBlock Text="桌面控制台" FontSize="13" Foreground="#9AA6B2" />
                <TextBlock Text="安装包从缤纷云下载" FontSize="11"
                           Foreground="#5C6773" Margin="0,30,0,0" />
            </StackPanel>
        </Border>

        <!-- 左上角关闭 -->
        <Button x:Name="CloseButton" Content="✕" Width="42" Height="34"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                Margin="8,6,0,0" FontSize="13" Cursor="Hand"
                Background="Transparent" BorderThickness="0"
                Foreground="#9AA6B2" Click="OnClose">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" CornerRadius="6" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#33FFFFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <Grid Grid.Column="1" Margin="28,46,28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 第一步：选择目录 -->
            <StackPanel x:Name="PathPage" Grid.Row="0">
                <TextBlock Text="选择安装位置" FontSize="20" FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}" />
                <TextBlock Text="BukaMusic 控制台会安装到这里，程序文件将从缤纷云下载。"
                           FontSize="12.5" Foreground="{StaticResource SubTextBrush}"
                           Margin="0,8,0,20" TextWrapping="Wrap" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="PathBox" Grid.Column="0" />
                    <Button Grid.Column="1" Content="浏览…" Margin="8,0,0,0"
                            Style="{StaticResource BaseButton}" Click="OnBrowse" />
                </Grid>
                <Border Background="{StaticResource CardBrush}" CornerRadius="8"
                        BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1"
                        Padding="14" Margin="0,18,0,0">
                    <StackPanel>
                        <TextBlock Text="安装内容" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}" />
                        <TextBlock Text="• BukaMusic 控制台（自带 .NET 与 Windows App SDK）"
                                   FontSize="12" Foreground="{StaticResource SubTextBrush}"
                                   Margin="0,6,0,0" />
                        <TextBlock Text="• 桌面与开始菜单快捷方式、卸载入口"
                                   FontSize="12" Foreground="{StaticResource SubTextBrush}"
                                   Margin="0,3,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 第二步：安装中 -->
            <StackPanel x:Name="ProgressPage" Grid.Row="0" Visibility="Collapsed"
                        VerticalAlignment="Center">
                <TextBlock Text="正在安装" FontSize="20" FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}" />
                <TextBlock x:Name="StatusText" Text="准备就绪" FontSize="12.5"
                           Foreground="{StaticResource SubTextBrush}" Margin="0,8,0,18" />
                <ProgressBar x:Name="Progress" Height="6" Minimum="0" Maximum="100"
                             Value="0" Foreground="{StaticResource AccentBrush}"
                             Background="#2A2C33" BorderThickness="0" />
            </StackPanel>

            <!-- 第三步：完成 -->
            <StackPanel x:Name="DonePage" Grid.Row="0" Visibility="Collapsed"
                        VerticalAlignment="Center">
                <TextBlock Text="安装完成" FontSize="20" FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}" />
                <TextBlock x:Name="DoneText" Text="BukaMusic 控制台已经安装好了。"
                           FontSize="12.5" Foreground="{StaticResource SubTextBrush}"
                           Margin="0,8,0,16" TextWrapping="Wrap" />
                <CheckBox x:Name="RunBox" Content="立即运行 BukaMusic 控制台"
                          IsChecked="True" FontSize="12.5" />
            </StackPanel>

            <!-- 底部按钮 -->
            <StackPanel Grid.Row="1" Orientation="Horizontal"
                        HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button x:Name="CancelButton" Content="取消" Style="{StaticResource BaseButton}"
                        Click="OnCancel" />
                <Button x:Name="InstallButton" Content="安装" Margin="10,0,0,0"
                        Style="{StaticResource AccentButton}" Click="OnInstall" />
                <Button x:Name="FinishButton" Content="完成" Margin="10,0,0,0"
                        Style="{StaticResource AccentButton}" Visibility="Collapsed"
                        Click="OnFinish" />
            </StackPanel>
        </Grid>
    </Grid>
    </Border>
</Window>
