<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="BukaMusicDesktop.Views.DevicesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:BukaMusicDesktop.Core"
    xmlns:controls="using:BukaMusicDesktop.Controls"
    Background="{StaticResource BgBrush}">

    <Grid Margin="26,20,26,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶部：说明 + 手动添加 -->
        <Border Grid.Row="0" Style="{StaticResource SectionCardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="选择设备" FontFamily="{StaticResource UiFont}"
                               FontSize="20" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Style="{StaticResource HintTextStyle}"
                               Text="同一局域网内的 BukaMusic 设备会自动出现在下方；点击设备卡片即可开始控制。" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                            VerticalAlignment="Center">
                    <TextBox x:Name="ManualBox" Width="190" Height="34"
                             PlaceholderText="IP:端口" />
                    <Button Content="添加" Style="{StaticResource GhostButtonStyle}"
                            Click="OnAddManual" />
                    <Button Content="刷新" Style="{StaticResource AccentButtonStyle}"
                            Click="OnRefresh" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 设备卡片 -->
        <Grid Grid.Row="1">
            <GridView x:Name="DeviceGrid"
                      IsItemClickEnabled="True"
                      ItemClick="OnDeviceClick"
                      SelectionMode="None"
                      Padding="0,4,0,0">
                <!-- The list refreshes every two seconds; without this the cards
                     replay their add/remove transition on every poll. -->
                <GridView.ItemContainerTransitions>
                    <TransitionCollection />
                </GridView.ItemContainerTransitions>
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="core:DeviceInfo">
                        <Border Width="330" Height="158" Margin="0,0,14,14"
                                Background="{StaticResource CardBrush}"
                                BorderBrush="{StaticResource StrokeBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="16"
                                PointerEntered="OnCardPointerEntered"
                                PointerExited="OnCardPointerExited">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                                    <Ellipse Width="9" Height="9" VerticalAlignment="Center"
                                             Fill="{x:Bind StatusBrush, Mode=OneWay}" />
                                    <controls:MarqueeText Text="{x:Bind Name, Mode=OneWay}"
                                                          MaxWidth="180"
                                                          FontFamily="{StaticResource UiFont}"
                                                          FontSize="15" FontWeight="SemiBold"
                                                          Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="{x:Bind StatusText, Mode=OneWay}"
                                               VerticalAlignment="Center"
                                               FontFamily="{StaticResource UiFont}" FontSize="11"
                                               Foreground="{x:Bind StatusBrush, Mode=OneWay}" />
                                </StackPanel>

                                <controls:MarqueeText Grid.Row="1" Text="{x:Bind Subtitle, Mode=OneWay}"
                                                      Margin="0,6,0,0"
                                                      FontFamily="{StaticResource UiFont}" FontSize="12"
                                                      Foreground="{StaticResource TextSecondaryBrush}" />

                                <StackPanel Grid.Row="2" Margin="0,10,0,0" Spacing="3">
                                    <controls:MarqueeText Text="{x:Bind EndPoint, Mode=OneWay}"
                                                          FontFamily="Consolas" FontSize="12"
                                                          Foreground="{StaticResource AccentBrush}" />
                                    <controls:MarqueeText Text="{x:Bind Detail, Mode=OneWay}"
                                                          FontFamily="{StaticResource UiFont}" FontSize="11"
                                                          Foreground="{StaticResource TextSecondaryBrush}" />
                                </StackPanel>

                                <TextBlock Grid.Row="3" Text="{x:Bind core:Loc.CardHint}"
                                           FontFamily="{StaticResource UiFont}" FontSize="12"
                                           Foreground="{StaticResource AccentBrush}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>

            <TextBlock x:Name="EmptyHint"
                       Text="还没有发现设备…&#x0a;请确认设备与电脑在同一局域网，或手动添加 IP。"
                       TextAlignment="Center" HorizontalAlignment="Center"
                       VerticalAlignment="Center" LineHeight="22"
                       FontFamily="{StaticResource UiFont}" FontSize="13"
                       Foreground="{StaticResource TextSecondaryBrush}" />
        </Grid>
    </Grid>
</Page>
